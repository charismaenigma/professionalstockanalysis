# Primary market-price provider. Massive Stocks Basic can provide end-of-day
# US stock/ETF OHLCV data for personal testing.
MASSIVE_API_KEY=

# Optional supplemental FMP access.
FMP_API_KEY=

# Optional AI research summaries. Core scores do not depend on this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# SEC asks automated clients to identify themselves with contact information.
SEC_USER_AGENT=MarketClarity your-email@example.com

# Clerk application credentials (set secrets directly in Vercel, never in chat).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Your Stripe account and approved recurring MarketClarity price IDs.
STRIPE_SECRET_KEY=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
STRIPE_AUTOMATIC_TAX=false

# Canonical HTTPS origin. Preview/testing must use its own origin and test keys.
APP_BASE_URL=https://marketclarity-live.vercel.app

# Optional owner access: trusted Clerk user IDs, never email addresses or client metadata.
MARKETCLARITY_ADMIN_USER_IDS=
