# Core live data provider. The app falls back to demo mode when omitted.
FMP_API_KEY=

# Options chain / Greeks provider. Optional.
MASSIVE_API_KEY=

# Optional AI research summaries. Core scores do not depend on this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# SEC asks automated clients to identify themselves with contact information.
SEC_USER_AGENT=MarketClarity your-email@example.com
