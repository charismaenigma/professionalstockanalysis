# Primary market-price provider. Massive Stocks Basic can provide end-of-day
# US stock/ETF OHLCV data for personal testing.
MASSIVE_API_KEY=

# Optional supplemental FMP access. The free FMP plan may not expose the
# stock-price/fundamental endpoints needed by the full scoring model.
FMP_API_KEY=

# Optional AI research summaries. Core scores do not depend on this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# SEC asks automated clients to identify themselves with contact information.
SEC_USER_AGENT=MarketClarity your-email@example.com
